n                            </label>\n                            <div class=\"field-value\" data-kid=\"1-2-2-1-3-2-2-2\" data-name=\"quantity field value display\">\n                                1\n                            </div>\n                        </div>\n                        <div class=\"field price-field\" data-kid=\"1-2-2-1-3-2-3\" data-name=\"price suggestion field group\">\n                            <label data-kid=\"1-2-2-1-3-2-3-1\" data-name=\"price suggestion field label\">\n                                Preisvorschlag / Stück ($)\n                            </label>\n                            <div class=\"field-value\" data-kid=\"1-2-2-1-3-2-3-2\" data-name=\"price suggestion field value display\">\n                                Dein Vorschlag\n                            </div>\n                        </div>\n                        <button class=\"add-wish\" data-kid=\"1-2-2-1-3-2-4\" data-name=\"add wanted item to order button\" type=\"button\">\n                            Zur Bestellung hinzufügen\n                        </button>\n                    </div>\n                    <p class=\"wish-footnote\" data-kid=\"1-2-2-1-3-3\" data-name=\"wanted item form footnote\">\n                        Der Vorschlag wird als Position in deinen aktuellen Warenkorb übernommen — er ist keine Merkliste.\n                    </p>\n                </section>\n            </div>\n            <aside aria-label=\"Bestellung und Merkliste\" class=\"side-rail\" data-dynamic=\"true\" data-kid=\"1-2-2-2\" data-name=\"side rail column for cart\" data-reason=\"false\">\n                <section aria-labelledby=\"cart-title\" class=\"cart-panel\" data-kid=\"1-2-2-2-1\" data-name=\"shopping cart panel\">\n                    <div class=\"side-head\" data-kid=\"1-2-2-2-1-1\" data-name=\"shopping cart panel header\">\n                        <h2 data-kid=\"1-2-2-2-1-1-1\" data-name=\"shopping cart panel title\" id=\"cart-title\">\n                            Warenkorb\n                        </h2>\n                        <span class=\"count-pill\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"shopping cart position count pill\">\n                            1 Position\n                        </span>\n                    </div>\n                    <div class=\"cart-item\" data-kid=\"1-2-2-2-1-2\" data-name=\"cart line item row\">\n                        <div class=\"cart-thumb\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"cart item thumbnail frame\">\n                            <img alt=\"\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"cart item thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/revolver.png\"/>\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-2-2\" data-name=\"cart item name and meta group\">\n                            <p class=\"cart-item-name\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"cart item name\">\n                                Revolver\n                            </p>\n                            <span class=\"cart-item-meta\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"cart item quantity and unit price meta\">\n                                Menge 1 · 32.000 $ / Stück\n                            </span>\n                        </div>\n                        <strong class=\"cart-item-price\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"cart item line price\">\n                            32.000 $\n                        </strong>\n                    </div>\n                    <div class=\"cart-total\" data-kid=\"1-2-2-2-1-3\" data-name=\"cart subtotal row\">\n                        <span data-kid=\"1-2-2-2-1-3-1\" data-name=\"subtotal label\">\n                            Zwischensumme\n                        </span>\n                        <strong data-kid=\"1-2-2-2-1-3-2\" data-name=\"subtotal amount\">\n                            32.000 $\n                        </strong>\n                    </div>\n                    <div class=\"cart-fields\" data-kid=\"1-2-2-2-1-4\" data-name=\"cart contact fields container\">\n                        <div class=\"field\" data-kid=\"1-2-2-2-1-4-1\" data-name=\"IC name field group\">\n                            <label data-kid=\"1-2-2-2-1-4-1-1\" data-name=\"IC name field label\">\n                                IC-Name\n                            </label>\n                            <div class=\"field-value\" data-kid=\"1-2-2-2-1-4-1-2\" data-name=\"IC name field value display\">\n                                Dein IC-Name\n                            </div>\n                        </div>\n                        <div class=\"field\" data-kid=\"1-2-2-2-1-4-2\" data-name=\"IC phone field group\">\n                            <label data-kid=\"1-2-2-2-1-4-2-1\" data-name=\"IC phone field label\">\n                                Handynummer / IC\n                            </label>\n                            <div class=\"field-value\" data-kid=\"1-2-2-2-1-4-2-2\" data-name=\"IC phone field value display\">\n                                Deine IC-Handynummer\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"order-disabled\" data-kid=\"1-2-2-2-1-5\" data-name=\"disabled order submission button\" disabled=\"\" type=\"button\">\n                        Bestellung absenden\n                    </button>\n                    <p class=\"disabled-note\" data-kid=\"1-2-2-2-1-6\" data-name=\"order disabled explanatory note\">\n                        Noch nicht bereit — bitte Kontaktdaten ergänzen.\n                    </p>\n                </section>\n                <div class=\"empty-state-preview\" data-kid=\"1-2-2-2-2\" data-name=\"empty cart state preview\">\n                    <span class=\"preview-label\" data-kid=\"1-2-2-2-2-1\" data-name=\"empty state preview label\">\n                        Bei 0 Positionen\n                    </span>\n                    <p data-kid=\"1-2-2-2-2-2\" data-name=\"empty state description text\">\n                        Dein Warenkorb ist noch leer. Füge zuerst ein Produkt hinzu.\n                    </p>\n                    <button data-kid=\"1-2-2-2-2-3\" data-name=\"disabled preview order button\" disabled=\"\" type=\"button\">\n                        Bestellung absenden\n                    </button>\n                </div>\n                <section aria-labelledby=\"wishlist-title\" class=\"wishlist-panel\" data-kid=\"1-2-2-2-3\" data-name=\"wishlist (Merkliste) panel\">\n                    <div class=\"side-head\" data-kid=\"1-2-2-2-3-1\" data-name=\"wishlist panel header\">\n                        <h2 data-kid=\"1-2-2-2-3-1-1\" data-name=\"wishlist panel title\" id=\"wishlist-title\">\n                            Merkliste\n                        </h2>\n                        <span class=\"count-pill\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"wishlist saved count pill\">\n                            2 gespeichert\n                        </span>\n                    </div>\n                    <p class=\"wishlist-note\" data-kid=\"1-2-2-2-3-2\" data-name=\"wishlist local storage note\">\n                        <i aria-hidden=\"true\" class=\"bi bi-heart-fill icon\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"heart fill note icon\">\n                        </i>\n                        Nur auf diesem Gerät gespeichert · ohne Konto\n                    </p>\n                    <div class=\"saved-row\" data-kid=\"1-2-2-2-3-3\" data-name=\"Medkit wishlist row\">\n                        <img alt=\"\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"Medkit wishlist thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/medkit.png\"/>\n                        <span class=\"saved-row-copy\" data-kid=\"1-2-2-2-3-3-2\" data-name=\"Medkit wishlist copy group\">\n                            <strong data-kid=\"1-2-2-2-3-3-2-1\" data-name=\"Medkit wishlist item name\">\n                                Medkit\n                            </strong>\n                            <span data-kid=\"1-2-2-2-3-3-2-2\" data-name=\"Medkit wishlist price and status\">\n                                2.200 $ · Verfügbar\n                            </span>\n                        </span>\n                        <i aria-hidden=\"true\" class=\"bi bi-heart-fill icon\" data-kid=\"1-2-2-2-3-3-3\" data-name=\"Medkit wishlist heart icon\">\n                        </i>\n                    </div>\n                    <div class=\"saved-row\" data-kid=\"1-2-2-2-3-4\" data-name=\"Revolver wishlist row\">\n                        <img alt=\"\" data-kid=\"1-2-2-2-3-4-1\" data-name=\"Revolver wishlist thumbnail\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/revolver.png\"/>\n                        <span class=\"saved-row-copy\" data-kid=\"1-2-2-2-3-4-2\" data-name=\"Revolver wishlist copy group\">\n                            <strong data-kid=\"1-2-2-2-3-4-2-1\" data-name=\"Revolver wishlist item name\">\n                                Revolver\n                            </strong>\n                            <span data-kid=\"1-2-2-2-3-4-2-2\" data-name=\"Revolver wishlist price and status\">\n                                32.000 $ · Verfügbar\n                            </span>\n                        </span>\n                        <i aria-hidden=\"true\" class=\"bi bi-heart-fill icon\" data-kid=\"1-2-2-2-3-4-3\" data-name=\"Revolver wishlist heart icon\">\n                        </i>\n                    </div>\n                </section>\n                <section aria-labelledby=\"zero-title\" class=\"no-results-preview\" data-kid=\"1-2-2-2-4\" data-name=\"no search results preview section\">\n                    <div class=\"no-results-head\" data-kid=\"1-2-2-2-4-1\" data-name=\"no results preview header\">\n                        <strong data-kid=\"1-2-2-2-4-1-1\" data-name=\"no results preview title\" id=\"zero-title\">\n                            Suchvorschau\n                        </strong>\n                        <span data-kid=\"1-2-2-2-4-1-2\" data-name=\"no results hit count\">\n                            0 Treffer\n                        </span>\n                    </div>\n                    <div class=\"query-chip\" data-kid=\"1-2-2-2-4-2\" data-name=\"search query chip\">\n                        <i aria-hidden=\"true\" class=\"bi bi-search icon\" data-kid=\"1-2-2-2-4-2-1\" data-name=\"search query chip magnifier icon\">\n                        </i>\n                        „Schrotflinte“\n                    </div>\n                    <p class=\"no-results-title\" data-kid=\"1-2-2-2-4-3\" data-name=\"no results headline text\">\n                        Keine Produkte für „Schrotflinte“ gefunden.\n                    </p>\n                    <button class=\"wish-cta\" data-kid=\"1-2-2-2-4-4\" data-name=\"wish item suggestion CTA button\" type=\"button\">\n                        Als Wunschartikel vorschlagen\n                        <i aria-hidden=\"true\" class=\"bi bi-arrow-right icon\" data-kid=\"1-2-2-2-4-4-1\" data-name=\"arrow-right CTA icon\">\n                        </i>\n                    </button>\n                </section>\n                <section aria-label=\"Werbung\" class=\"ad-panel\" data-kid=\"1-2-2-2-5\" data-name=\"advertising panel\">\n                    <img alt=\"Werbefläche im OLYMP Shop\" data-kid=\"1-2-2-2-5-1\" data-name=\"advertising panel image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/werbung1.png\"/>\n                    <div class=\"ad-copy\" data-kid=\"1-2-2-2-5-2\" data-name=\"advertising copy group\">\n                        <small data-kid=\"1-2-2-2-5-2-1\" data-name=\"advertising label\">\n                            Werbung\n                        </small>\n                        <strong data-kid=\"1-2-2-2-5-2-2\" data-name=\"advertising headline\">\n                            Werbefläche