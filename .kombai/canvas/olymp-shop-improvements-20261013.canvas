      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n@font-face{font-family:Orbitron;font-style:normal;font-weight:500 900;font-display:swap;src:url('/api/local/images/img/fonts/orbitron-latin-700-normal.woff2') format('woff2')}\n@font-face{font-family:Exo2;font-style:normal;font-weight:400;font-display:swap;src:url('/api/local/images/img/fonts/exo-2-latin-400-normal.woff2') format('woff2')}\n@font-face{font-family:Exo2;font-style:normal;font-weight:600 800;font-display:swap;src:url('/api/local/images/img/fonts/exo-2-latin-600-normal.woff2') format('woff2')}\n:root{--bg:#070b10;--surface:#0d1319;--surface-raised:#111a22;--surface-hover:#17232d;--line:#263642;--line-soft:#1b2933;--text:#edf3f8;--muted:#93a2ad;--muted-2:#71808a;--blue:#8ec6e8;--blue-strong:#45a8e8;--blue-wash:rgba(69,168,232,.12);--yellow:#ffd814;--yellow-hover:#f7ca00;--green:#74d5a0;--red:#fb7185;--font-display:Orbitron,'Segoe UI',sans-serif;--font-body:Exo2,'Segoe UI',sans-serif}\n.olymp-shop{min-height:100vh;background:radial-gradient(ellipse at 50% -15%,#142534 0%,var(--bg) 54%);color:var(--text);font-family:var(--font-body);font-size:14px;line-height:1.5;padding-bottom:44px}\n.olymp-shop *{box-sizing:border-box}\n.page-width{width:min(1320px,calc(100% - 64px));margin:0 auto}\n.site-header{background:rgba(8,14,20,.96);border-bottom:1px solid var(--line);box-shadow:0 8px 26px rgba(0,0,0,.22)}\n.header-main{min-height:78px;display:flex;align-items:center;gap:28px}\n.brand{display:flex;align-items:center;gap:12px;min-width:204px;color:var(--text);text-decoration:none}\n.brand img{width:43px;height:43px;object-fit:cover;border-radius:50%;border:1px solid rgba(142,198,232,.46);background:#000}\n.brand-name{font:700 15px/1.15 var(--font-display);letter-spacing:.08em}\n.brand-name small{display:block;margin-top:5px;color:var(--blue);font:600 9px/1 var(--font-body);letter-spacing:.19em}\n.search-form{display:flex;align-items:center;flex:1;height:46px;max-width:700px;overflow:hidden;border:1px solid #3c5667;border-radius:8px;background:#f4f7f9;box-shadow:0 0 0 3px rgba(69,168,232,.06)}\n.search-icon{width:45px;text-align:center;color:#607785;font-size:19px}\n.search-input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:#17232b;font:500 14px var(--font-body)}\n.search-input::placeholder{color:#6d7b84}\n.search-submit{height:100%;width:48px;border:0;border-left:1px solid #d4dfe6;background:#e4f2fa;color:#1c628a;font-size:20px}\n.header-actions{display:flex;align-items:center;gap:10px;margin-left:auto}\n.header-action{display:flex;align-items:center;gap:8px;min-height:44px;padding:7px 13px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--text);text-decoration:none;font-weight:700;white-space:nowrap}\n.header-action .ti{font-size:20px;color:var(--blue);width:20px;height:20px}\n.count{display:inline-grid;place-items:center;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:var(--blue-strong);color:#06121a;font:700 11px var(--font-body)}\n.count.gold{background:var(--yellow)}\n.category-nav{display:flex;align-items:center;gap:8px;min-height:48px;border-top:1px solid rgba(255,255,255,.04)}\n.category-nav a{padding:8px 13px;border-radius:6px;color:#c7d5de;text-decoration:none;font-size:12px;font-weight:700;letter-spacing:.03em}\n.category-nav a:first-child{background:var(--blue-wash);color:var(--blue)}\n.category-nav a:hover{color:#fff;background:rgba(255,255,255,.05)}\n.nav-spacer{flex:1}\n.nav-note{color:var(--muted);font-size:11px}\nmain.page-width{padding-top:27px}\n.page-intro{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 19px}\n.eyebrow{margin:0 0 5px;color:var(--blue);font:700 10px/1.2 var(--font-display);letter-spacing:.18em;text-transform:uppercase}\nh1{margin:0;font:700 27px/1.2 var(--font-display);letter-spacing:.02em}\n.page-subtitle{margin:7px 0 0;color:var(--muted);font-size:13px}\n.search-shortcut{color:var(--blue);font-weight:700;text-decoration:none;font-size:12px;white-space:nowrap}\n.search-shortcut .ti{font-size:15px;vertical-align:-2px;margin-right:4px}\n.content-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:28px;align-items:start}\n.main-column{min-width:0}\n.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 12px}\n.section-head h2{margin:0;font:700 17px/1.3 var(--font-display);letter-spacing:.015em}\n.section-sub{color:var(--muted);font-size:12px}\n.offer-section{margin-bottom:27px}\n.offer-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(270px,.8fr);min-height:220px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:linear-gradient(110deg,#0c151e,#101b24)}\n.offer-visual{position:relative;min-height:220px;background:#07111b}\n.offer-visual img{display:block;width:100%;height:100%;min-height:220px;object-fit:cover}\n.offer-copy{display:flex;flex-direction:column;justify-content:center;padding:20px 23px;border-left:1px solid rgba(142,198,232,.16)}\n.offer-label{display:inline-flex;align-self:flex-start;align-items:center;gap:6px;margin-bottom:8px;color:var(--blue);font:700 9px/1.2 var(--font-display);letter-spacing:.16em;text-transform:uppercase}\n.offer-copy h3{margin:0;font:700 16px/1.35 var(--font-display);letter-spacing:.02em}\n.offer-description{margin:7px 0 10px;color:#c1ccd3;font-size:12px;line-height:1.55}\n.bundle-items{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px}\n.bundle-items span{padding:3px 7px;border:1px solid rgba(142,198,232,.16);border-radius:4px;background:rgba(142,198,232,.055);color:#c5d3dc;font-size:10px;white-space:nowrap}\n.offer-buy-row{display:flex;align-items:center;justify-content:space-between;gap:10px}\n.offer-price{color:var(--blue);font:700 20px/1.2 var(--font-display);white-space:nowrap}\n.button-yellow{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:39px;padding:9px 15px;border:1px solid #dfba05;border-radius:7px;background:var(--yellow);color:#201d0d;font:700 12px/1 var(--font-body);text-decoration:none;white-space:nowrap}\n.button-yellow .ti{font-size:16px;width:16px;height:16px}\n.catalog-head{align-items:center;margin-bottom:14px}\n.catalog-tools{display:flex;align-items:center;gap:8px}\n.filter-chip{padding:6px 11px;border:1px solid var(--line);border-radius:999px;background:transparent;color:#b4c1c9;font-size:11px;font-weight:700;text-decoration:none}\n.filter-chip.active{border-color:rgba(69,168,232,.5);background:var(--blue-wash);color:var(--blue)}\n.sort-label{margin-left:5px;color:var(--muted-2);font-size:11px}\n.sort-button{padding:6px 9px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:#c9d5dc;font:600 11px var(--font-body)}\n.product-group{margin-top:20px}\n.group-title{display:flex;align-items:center;gap:10px;margin:0 0 10px;color:#d8e6ef;font:700 11px/1.2 var(--font-display);letter-spacing:.14em;text-transform:uppercase}\n.group-title::after{content:'';height:1px;flex:1;background:linear-gradient(90deg,var(--line),transparent)}\n.group-count{color:var(--muted-2);font:600 10px var(--font-body);letter-spacing:0}\n.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}\n.product-card{position:relative;display:flex;flex-direction:column;min-height:272px;padding:10px;border:1px solid #1d2d38;border-radius:9px;background:linear-gradient(160deg,#101820,#0b1117);transition:border-color .16s ease,background .16s ease}\n.product-card:hover{border-color:#3a718f;background:#111c25}\n.product-photo{display:grid;place-items:center;height:124px;margin-bottom:10px;overflow:hidden;border-radius:6px;background:radial-gradient(ellipse at 50% 60%,#202d37,#111820 72%)}\n.product-photo img{display:block;width:100%;height:100%;object-fit:contain}\n.favorite-button{position:absolute;top:16px;right:16px;z-index:1;display:grid;place-items:center;width:31px;height:31px;border:1px solid rgba(200,220,233,.2);border-radius:50%;background:rgba(5,11,16,.82);color:#aab8c0}\n.favorite-button .ti{width:17px;height:17px;font-size:17px}\n.favorite-button.saved{border-color:rgba(251,113,133,.4);color:var(--red);background:rgba(20,9,13,.88)}\n.product-info{display:flex;flex:1;flex-direction:column;gap:3px}\n.product-category{color:var(--muted-2);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}\n.product-name{min-height:37px;margin:0;color:var(--text);font:600 12px/1.45 var(--font-body)}\n.product-price{margin-top:1px;color:var(--blue);font:700 14px/1.2 var(--font-display);letter-spacing:.01em}\n.stock-label{display:flex;align-items:center;gap:5px;margin:5px 0 9px;color:#a3b1b9;font-size:10px}\n.stock-dot{width:6px;height:6px;border-radius:50%;background:var(--green)}\n.add-button{display:flex;align-items:center;justify-content:center;gap:7px;min-height:34px;width:100%;padding:7px 8px;border:1px solid rgba(255,216,20,.68);border-radius:6px;background:var(--yellow);color:#211e0d;font:700 11px var(--font-body)}\n.add-button .ti{font-size:15px;width:15px;height:15px}\n.add-button:hover,.button-yellow:hover{background:var(--yellow-hover)}\n.sidebar{display:flex;flex-direction:column;gap:15px;padding-top:1px}\n.side-panel{padding:15px;border:1px solid var(--line);border-radius:10px;background:linear-gradient(150deg,#101921,#0b1117)}\n.side-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:11px}\n.side-title{margin:0;font:700 13px/1.25 var(--font-display);letter-spacing:.02em}\n.side-title .ti{margin-right:5px;color:var(--blue);font-size:16px;vertical-align:-2px}\n.side-link{color:var(--blue);font-size:10px;font-weight:700;text-decoration:none;white-space:nowrap}\n.local-note{display:flex;align-items:flex-start;gap:6px;margin:0 0 12px;color:var(--muted);font-size:10px;line-height:1.4}\n.local-note .ti{color:var(--blue);font-size:13px;width:13px;height:13px;flex:0 0 13px}\n.saved-item{display:grid;grid-template-columns:60px minmax(0,1fr) 26px;align-items:center;gap:10px;padding:9px 0;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}\n.saved-thumb{display:grid;place-items:center;width:60px;height:60px;overflow:hidden;border-radius:6px;background:#18232c}\n.saved-thumb img{width:100%;height:100%;object-fit:contain}\n.saved-name{margin:0;color:var(--text);font-size:12px;font-weight:700}\n.saved-category{margin:2px 0 4px;color:var(--muted-2);font-size:9px}\n.saved-price{color:var(--blue);font:700 12px var(--font-display)}\n.saved-heart{display:grid;place-items:center;width:26px;height:26px;border:0;background:transparent;color:var(--red);font-size:17px}\n.saved-cta{width:100%;margin-top:10px;min-height:33px;border:1px solid rgba(142,198,232,.35);border-radius:6px;background:rgba(142,198,232,.08);color:#cbe8f8;font:700 10px var(--font-body)}\n.cart-line{display:grid;grid-template-columns:42px minmax(0,1fr) auto;gap:9px;align-items:center;padding:8px 0 10px;border-bottom:1px solid var(--line-soft)}\n.cart-thumb{display:grid;place-items:center;width:42px;height:42px;overflow:hidden;border-radius:5px;background:#19242d}\n.cart-thumb img{width:100%;height:100%;object-fit:contain}\n.cart-name{margin:0;font-size:11px;font-weight:700}\n.cart-unit{margin:2px 0 0;color:var(--muted);font-size:9px}\n.cart-line-total{color:#e9f2f8;font:700 10px var(--font-display);white-space:nowrap}\n.quantity-row{display:flex;align-items:center;gap:5px;margin-top:7px}\n.quantity-control{display:flex;align-items:center;height:24px;border:1px solid var(--line);border-radius:5px;overflow:hidden;background:#080e13}\n.quantity-control span{display:grid;place-items:center;width:22px;height:22px;color:#d3e0e7;font-size:13px}\n.quantity-control strong{width:23px;text-align:center;color:var(--text);font-size:10px}\n.quantity-hint{color:var(--muted-2);font-size:9px}\n.cart-summary{display:grid;gap:5px;padding:11px 0 10px}\n.summary-row{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:10px}\n.summary-row.total{padding-top:7px;border-top:1px solid var(--line-soft);color:var(--text);font-size:12px;font-weight:700}\n.summary-row.total strong{color:var(--blue);font:700 15px var(--font-display)}\n.checkout-button{display:flex;align-items:center;justify-content:center;gap:7px;width:100%;min-height:36px;border:0;border-radius:6px;background:linear-gradient(100deg,#c8ebfb,#8ec6e8);color:#0b1921;font:700 11px var(--font-display);letter-spacing:.04em;text-decoration:none}\n.checkout-button .ti{font-size:16px}\n.ad-panel{display:grid;grid-template-columns:86px minmax(0,1fr);align-items:center;gap:12px;padding:11px;border:1px solid #1b2b35;border-radius:9px;background:rgba(11,17,23,.74)}\n.ad-image{display:block;width:86px;height:126px;object-fit:cover;object-position:center;border-radius:5px;opacity:.92}\n.ad-copy{min-width:0}\n.ad-label{display:block;margin-bottom:5px;color:var(--muted-2);font:700 8px var(--font-display);letter-spacing:.14em;text-transform:uppercase}\n.ad-copy strong{display:block;color:#d8e4eb;font-size:11px;line-height:1.35}\n.ad-copy p{margin:5px 0 0;color:var(--muted);font-size:9px;line-height:1.4}\n.ad-copy a{display:inline-block;margin-top:8px;color:var(--blue);font-size:9px;font-weight:700;text-decoration:none}\n.wish-order{margin-top:30px;padding:18px 0 4px;border-top:1px solid var(--line)}\n.wish-order-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:13px}\n.wish-order-title{margin:0;font:700 15px/1.3 var(--font-display)}\n.wish-order-description{margin:5px 0 0;color:var(--muted);font-size:11px}\n.wish-order-tag{display:inline-flex;align-items:center;gap:6px;flex:0 0 auto;padding:6px 9px;border:1px solid rgba(142,198,232,.25);border-radius:999px;background:var(--blue-wash);color:var(--blue);font-size:9px;font-weight:700}\n.wish-order-tag .ti{font-size:13px}\n.wish-fields{display:grid;grid-template-columns:1.45fr .55fr .9fr auto;gap:9px;align-items:end}\n.field{display:grid;gap:5px;min-width:0}\n.field label{color:#c8d5dc;font-size:10px;font-weight:700}\n.field input{height:38px;width:100%;min-width:0;padding:0 10px;border:1px solid var(--line);border-radius:6px;outline:none;background:#090f14;color:var(--text);font:500 11px var(--font-body)}\n.field input::placeholder{color:#667781}\n.field input:focus{border-color:var(--blue-strong);box-shadow:0 0 0 2px rgba(69,168,232,.13)}\n.wish-add{height:38px;padding:0 14px;border:1px solid #375267;border-radius:6px;background:#142532;color:#d3efff;font:700 10px var(--font-body);white-space:nowrap}\n.wish-price-note{margin:8px 0 0;color:var(--muted-2);font-size:9px}\n.site-footer{display:flex;justify-content:space-between;gap:14px;margin-top:30px;padding-top:12px;border-top:1px solid var(--line-soft);color:#71808a;font-size:9px}\n@media(max-width:1100px){.page-width{width:min(100% - 40px,1050px)}.content-layout{grid-template-columns:minmax(0,1fr) 270px;gap:18px}.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.header-main{gap:16px}.brand{min-width:165px}.header-action{padding:7px 9px}.offer-layout{grid-template-columns:1fr}.offer-copy{border-left:0;border-top:1px solid rgba(142,198,232,.16)}}\n@media(max-width:780px){.page-width{width:calc(100% - 28px)}.header-main{flex-wrap:wrap;padding:12px 0;gap:11px}.brand{min-width:0}.brand-name{font-size:13px}.search-form{order:3;max-width:none;flex-basis:100%}.header-actions{margin-left:auto}.header-action{min-height:39px;font-size:10px}.category-nav{overflow:auto}.nav-note{display:none}.content-layout{grid-template-columns:1fr}.sidebar{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.ad-panel{grid-column:1/-1}.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.catalog-tools{flex-wrap:wrap;justify-content:flex-end}}\n@media(max-width:560px){h1{font-size:21px}.page-intro{align-items:flex-start;flex-direction:column}.search-shortcut{white-space:normal}.category-nav a{padding:8px 10px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.product-card{min-height:260px}.product-photo{height:112px}.catalog-head{align-items:flex-start;flex-direction:column}.catalog-tools{justify-content:flex-start}.sidebar{grid-template-columns:1fr}.ad-panel{grid-column:auto}.wish-order-head{flex-direction:column}.wish-fields{grid-template-columns:1fr 1fr}.wish-fields .field:first-child{grid-column:1/-1}.wish-add{grid-column:1/-1}.offer-copy{padding:17px}.offer-buy-row{align-items:flex-start;flex-direction:column}.offer-buy-row .button-yellow{width:100%}.site-footer{flex-direction:column}}\n</style>\n<div class=\"olymp-shop\" data-kid=\"1\" data-name=\"olymp shop page wrapper\">\n    <header class=\"site-header\" data-kid=\"1-1\" data-name=\"site header\">\n        <div class=\"page-width header-main\" data-kid=\"1-1-1\" data-name=\"header top bar with brand search and actions\">\n            <a aria-label=\"OLYMP Shop\" class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#shop\">\n                <img alt=\"Ischia FamQ Logo\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/Ischia-famq.png\"/>\n                <span class=\"brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    OLYMP SHOP\n                    <small data-kid=\"1-1-1-1-2-1\" data-name=\"brand tagline subtitle\">\n                        VERSORGUNG · AUSRÜSTUNG\n                    </small>\n                </span>\n            </a>\n            <form class=\"search-form\" data-kid=\"1-1-1-2\" data-name=\"product search form\" role=\"search\">\n                <span class=\"search-icon\" data-kid=\"1-1-1-2-1\" data-name=\"search icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-search\" data-kid=\"1-1-1-2-1-1\" data-name=\"search magnifier icon\">\n                    </i>\n                </span>\n                <input aria-label=\"Produkte suchen\" class=\"search-input\" data-kid=\"1-1-1-2-2\" data-name=\"product search input field\" placeholder=\"Produkte suchen …\" type=\"search\"/>\n                <button aria-label=\"Suche\" class=\"search-submit\" data-kid=\"1-1-1-2-3\" data-name=\"search submit button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-1-1-2-3-1\" data-name=\"search arrow icon\">\n                    </i>\n                </button>\n            </form>\n            <div class=\"header-actions\" data-kid=\"1-1-1-3\" data-name=\"header action buttons container\">\n                <a class=\"header-action\" data-kid=\"1-1-1-3-1\" data-name=\"merklstiche (wishlist) header link\" href=\"#merkliste\">\n                    <i aria-hidden=\"true\" class=\"ti ti-heart\" data-kid=\"1-1-1-3-1-1\" data-name=\"wishlist heart icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-1-2\" data-name=\"wishlist link label\">\n                        Merkliste\n                    </span>\n                    <span class=\"count\" data-kid=\"1-1-1-3-1-3\" data-name=\"wishlist item count badge\">\n                        1\n                    </span>\n                </a>\n                <a class=\"header-action\" data-kid=\"1-1-1-3-2\" data-name=\"shopping cart header link\" href=\"#warenkorb\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shopping-cart\" data-kid=\"1-1-1-3-2-1\" data-name=\"shopping cart icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-2-2\" data-name=\"shopping cart link label\">\n                        Warenkorb\n                    </span>\n                    <span class=\"count gold\" data-kid=\"1-1-1-3-2-3\" data-name=\"shopping cart item count badge\">\n                        1\n                    </span>\n                </a>\n            </div>\n        </div>\n        <nav aria-label=\"Produktkategorien\" class=\"page-width category-nav\" data-kid=\"1-1-2\" data-name=\"product category navigation bar\">\n            <a data-kid=\"1-1-2-1\" data-name=\"all products category nav link\" href=\"#katalog\">\n                Alle Produkte\n                <span class=\"count\" data-kid=\"1-1-2-1-1\" data-name=\"all products count badge\">\n                    8\n                </span>\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"ammunition category nav link\" href=\"#munition\">\n                Munition\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"consumables category nav link\" href=\"#verbrauch\">\n                Verbrauchsgegenstände\n            </a>\n            <a data-kid=\"1-1-2-4\" data-name=\"weapons category nav link\" href=\"#waffen\">\n                Waffen\n            </a>\n            <span class=\"nav-spacer\" data-kid=\"1-1-2-5\" data-name=\"category nav spacer\">\n            </span>\n            <span class=\"nav-note\" data-kid=\"1-1-2-6\" data-name=\"category nav pricing footnote\">\n                Preise in $ · Wunschartikel separat zur Bestellung ergänzbar\n            </span>\n        </nav>\n    </header>\n    <main class=\"page-width\" data-kid=\"1-2\" data-name=\"main shop page content\" id=\"shop\">\n        <div class=\"page-intro\" data-kid=\"1-2-1\" data-name=\"page intro header with title and shortcut\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page intro text container\">\n                <p class=\"eyebrow\" data-kid=\"1-2-1-1-1\" data-name=\"page eyebrow label\">\n                    OLYMP Versorgung\n                </p>\n                <h1 data-kid=\"1-2-1-1-2\" data-name=\"page main headline\">\n                    Shop\n                </h1>\n                <p class=\"page-subtitle\" data-kid=\"1-2-1-1-3\" data-name=\"page subtitle text\">\n                    Finde Ausrüstung für deinen nächsten Einsatz — oder merke Artikel für später.\n                </p>\n            </div>\n            <a class=\"search-shortcut\" data-kid=\"1-2-1-2\" data-name=\"wish item shortcut link\" href=\"#wunschartikel\">\n                <i aria-hidden=\"true\" class=\"ti ti-package-import\" data-kid=\"1-2-1-2-1\" data-name=\"wish item import icon\">\n                </i>\n                Nicht im Katalog? Als Wunschartikel hinzufügen\n            </a>\n        </div>\n        <div class=\"content-layout\" data-kid=\"1-2-2\" data-name=\"main content layout grid\">\n            <div class=\"main-column\" data-kid=\"1-2-2-1\" data-name=\"main content column\">\n                <section aria-labelledby=\"deal-title\" class=\"offer-section\" data-kid=\"1-2-2-1-1\" data-name=\"weekly offer section\">\n                    <div class=\"section-head\" data-kid=\"1-2-2-1-1-1\" data-name=\"offer section header\">\n                        <h2 data-kid=\"1-2-2-1-1-1-1\" data-name=\"offer section title\" id=\"deal-title\">\n                            Wochenangebot\n                        </h2>\n                        <span class=\"section-sub\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"offer section subtitle\">\n                            Aktionspaket · Festpreis\n                        </span>\n                    </div>\n                    <div class=\"offer-layout\" data-kid=\"1-2-2-1-1-2\" data-name=\"offer layout card\">\n                        <div class=\"offer-visual\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"offer visual image container\">\n                            <img alt=\"Wochenangebot mit Westen, Revolvern, Karabinern, Medkits, Kabelbindern und Munition\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"offer bundle image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/wochenangebot.png\"/>\n                        </div>\n                        <div class=\"offer-copy\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"offer copy container\">\n                            <span class=\"offer-label\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"offer bundle label\">\n                                <i aria-hidden=\"true\" class=\"ti ti-bolt\" data-kid=\"1-2-2-1-1-2-2-1-1\" data-name=\"offer bolt icon\">\n                                </i>\n                                Paketinhalt auf einen Blick\n                            </span>\n                            <h3 data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"offer headline\">\n                                Wochenangebot\n                                <br data-kid=\"1-2-2-1-1-2-2-2-1\" data-name=\"line break\"/>\n                                Aktionspaket\n                            </h3>\n                            <p class=\"offer-description\" data-kid=\"1-2-2-1-1-2-2-3\" data-name=\"offer description text\">\n                                Ein Paket mit Ausrüstung, Waffen und Munition:\n                            </p>\n                            <div class=\"bundle-items\" data-kid=\"1-2-2-1-1-2-2-4\" data-name=\"bundle items chips container\">\n                                <span data-kid=\"1-2-2-1-1-2-2-4-1\" data-name=\"bundle item chip (vests)\">\n                                    10× Weste\n                                </span>\n                                <span data-kid=\"1-2-2-1-1-2-2-4-2\" data-name=\"bundle item chip (revolvers)\">\n                                    2× Revolver\n                                </span>\n                                <span data-kid=\"1-2-2-1-1-2-2-4-3\" data-name=\"bundle item chip (carbines)\">\n                                    2× Karabiner\n                                </span>\n                                <span data-kid=\"1-2-2-1-1-2-2-4-4\" data-name=\"bundle item chip (medkits)\">\n                                    10× Medkit\n                                </span>\n                                <span data-kid=\"1-2-2-1-1-2-2-4-5\" data-name=\"bundle item chip (cable ties)\">\n                                    16× Kabelbinder\n                                </span>\n                                <span data-kid=\"1-2-2-1-1-2-2-4-6\" data-name=\"bundle item chip (ACP ammo)\">\n                                    4× ACP-Muni\n                                </span>\n                                <span data-kid=\"1-2-2-1-1-2-2-4-7\" data-name=\"bundle item chip (5.56 ammo)\">\n                                    4× 5.56-Muni\n                                </span>\n                            </div>\n                            <div class=\"offer-buy-row\" data-kid=\"1-2-2-1-1-2-2-5\" data-name=\"offer price and buy row\">\n                                <strong class=\"offer-price\" data-kid=\"1-2-2-1-1-2-2-5-1\" data-name=\"offer price text\">\n                                    200.000 $\n                                </strong>\n                                <button class=\"button-yellow\" data-kid=\"1-2-2-1-1-2-2-5-2\" data-name=\"add offer to cart button\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-shopping-cart-plus\" data-kid=\"1-2-2-1-1-2-2-5-2-1\" data-name=\"add to cart icon\">\n                                    </i>\n                                    In den Warenkorb\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"catalog-title\" data-kid=\"1-2-2-1-2\" data-name=\"product catalog section\" id=\"katalog\">\n                    <div class=\"section-head catalog-head\" data-kid=\"1-2-2-1-2-1\" data-name=\"catalog section header\">\n                        <div data-kid=\"1-2-2-1-2-1-1\" data-name=\"catalog title wrapper\">\n                            <h2 data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"catalog title\" id=\"catalog-title\">\n                                Alle Produkte\n                                <span class=\"section-sub\" data-kid=\"1-2-2-1-2-1-1-1-1\" data-name=\"catalog item count subtitle\">\n  