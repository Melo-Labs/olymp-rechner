    "var_6609ae8f0696": {
      "type": "variant",
      "label": "OLYMP Shop · Marktplatz",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css\");\n@font-face{font-family:\"Orbitron\";font-weight:500;font-style:normal;font-display:swap;src:url(\"/api/local/images/img/fonts/orbitron-latin-500-normal.woff2\") format(\"woff2\")}\n@font-face{font-family:\"Orbitron\";font-weight:700;font-style:normal;font-display:swap;src:url(\"/api/local/images/img/fonts/orbitron-latin-700-normal.woff2\") format(\"woff2\")}\n@font-face{font-family:\"Exo 2\";font-weight:400;font-style:normal;font-display:swap;src:url(\"/api/local/images/img/fonts/exo-2-latin-400-normal.woff2\") format(\"woff2\")}\n@font-face{font-family:\"Exo 2\";font-weight:600;font-style:normal;font-display:swap;src:url(\"/api/local/images/img/fonts/exo-2-latin-600-normal.woff2\") format(\"woff2\")}\n@font-face{font-family:\"Exo 2\";font-weight:700;font-style:normal;font-display:swap;src:url(\"/api/local/images/img/fonts/exo-2-latin-600-normal.woff2\") format(\"woff2\")}\n:root{--olymp-blue:#8ec6e8;--olymp-gold:#ffd814;--surface:#11171d;--surface-raised:#171f27;--line:#28343e;--muted:#9daab4;--ink:#eff3f6}\n.font-display{font-family:\"Orbitron\",\"Segoe UI\",sans-serif}\n.font-body{font-family:\"Exo 2\",\"Segoe UI\",sans-serif}\n</style>\n<div class=\"min-h-screen bg-[#070a0d] text-[#eff3f6] font-body selection:bg-[#8ec6e8]/30\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#26333d] bg-[#111922]\" data-kid=\"1-1\" data-name=\"site header with nav and search\">\n        <div class=\"mx-auto max-w-[1340px] px-7\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <div class=\"flex min-h-[82px] items-center gap-7\" data-kid=\"1-1-1-1\" data-name=\"header top bar with logo search and actions\">\n                <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1-1\" data-name=\"site logo and brand block\">\n                    <img alt=\"Ischia FamQ\" class=\"h-11 w-11 rounded-full border border-[#8ec6e8]/55 object-cover\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/Ischia-famq.png\"/>\n                    <div class=\"leading-tight\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name and tagline block\">\n                        <div class=\"font-display text-[17px] font-bold tracking-[.08em] text-white\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"brand title text\">\n                            OLYMP\n                            <span class=\"text-[#8ec6e8]\" data-kid=\"1-1-1-1-1-2-1-1\" data-name=\"brand title SHOP wordmark\">\n                                SHOP\n                            </span>\n                        </div>\n                        <div class=\"mt-1 text-[10px] font-semibold uppercase tracking-[.22em] text-[#92a1ad]\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"brand tagline text\">\n                            Katalog & Bestellungen\n                        </div>\n                    </div>\n                </div>\n                <label class=\"relative mx-auto flex h-[46px] min-w-[260px] max-w-[670px] flex-1 items-center\" data-kid=\"1-1-1-1-2\" data-name=\"site-wide search input field\">\n                    <span class=\"absolute left-4 text-[21px] text-[#657583]\" data-kid=\"1-1-1-1-2-1\" data-name=\"search magnifier icon wrapper\">\n                        <i class=\"ph ph-magnifying-glass\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"magnifying glass icon\" style=\"color:inherit;width:1em;height:1em\">\n                        </i>\n                    </span>\n                    <input aria-label=\"Produkte suchen\" class=\"h-full w-full rounded-lg border border-[#d1dae0] bg-[#f6f8fa] pl-12 pr-4 text-[15px] text-[#18232c] placeholder:text-[#6e7b84] outline-none ring-[#8ec6e8] focus:ring-2\" data-kid=\"1-1-1-1-2-2\" data-name=\"product search text input\" placeholder=\"Produkte, Kategorien oder Munition suchen\" type=\"search\"/>\n                    <kbd class=\"absolute right-3 rounded border border-[#d7dfe4] bg-white px-2 py-1 text-[10px] font-semibold text-[#74818a]\" data-kid=\"1-1-1-1-2-3\" data-name=\"search shortcut key indicator\">\n                        ⌕\n                    </kbd>\n                </label>\n                <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-1-3\" data-name=\"header action buttons group\">\n                    <button class=\"flex h-[46px] items-center gap-2 rounded-lg border border-[#32424f] bg-[#17222b] px-3 text-[13px] font-semibold text-[#e8f0f5]\" data-kid=\"1-1-1-1-3-1\" data-name=\"wishlist action button\" type=\"button\">\n                        <span class=\"relative grid size-7 place-items-center text-[21px] text-[#8ec6e8]\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"wishlist icon and badge\">\n                            <i class=\"ph-fill ph-heart\" data-kid=\"1-1-1-1-3-1-1-1\" data-name=\"heart icon\" style=\"color:inherit;width:1em;height:1em\">\n                            </i>\n                            <span class=\"absolute -right-1 -top-1 grid size-[17px] place-items-center rounded-full bg-[#8ec6e8] text-[10px] font-bold text-[#071017]\" data-kid=\"1-1-1-1-3-1-1-2\" data-name=\"wishlist item count badge\">\n                                1\n                            </span>\n                        </span>\n                        <span data-kid=\"1-1-1-1-3-1-2\" data-name=\"wishlist button label\">\n                            Merkliste\n                        </span>\n                    </button>\n                    <button class=\"flex h-[46px] items-center gap-2 rounded-lg border border-[#32424f] bg-[#17222b] px-3 text-[13px] font-semibold text-[#e8f0f5]\" data-kid=\"1-1-1-1-3-2\" data-name=\"cart action button\" type=\"button\">\n                        <span class=\"relative grid size-7 place-items-center text-[21px] text-[#ffd814]\" data-kid=\"1-1-1-1-3-2-1\" data-name=\"cart icon and badge\">\n                            <i class=\"ph ph-shopping-cart-simple\" data-kid=\"1-1-1-1-3-2-1-1\" data-name=\"shopping cart icon\" style=\"color:inherit;width:1em;height:1em\">\n                            </i>\n                            <span class=\"absolute -right-1 -top-1 grid size-[17px] place-items-center rounded-full bg-[#ffd814] text-[10px] font-bold text-[#17130a]\" data-kid=\"1-1-1-1-3-2-1-2\" data-name=\"cart item count badge\">\n                                1\n                            </span>\n                        </span>\n                        <span data-kid=\"1-1-1-1-3-2-2\" data-name=\"cart button label\">\n                            Warenkorb\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <nav aria-label=\"Shop-Kategorien\" class=\"flex items-center gap-2 border-t border-white/10 py-3\" data-kid=\"1-1-1-2\" data-name=\"category filter navigation\">\n                <button class=\"rounded-full border border-[#8ec6e8]/70 bg-[#8ec6e8]/15 px-4 py-2 text-[12px] font-bold text-[#bde6fb]\" data-kid=\"1-1-1-2-1\" data-name=\"all products filter button with count\" type=\"button\">\n                    Alle Produkte\n                    <span class=\"ml-1 text-[#8ec6e8]\" data-kid=\"1-1-1-2-1-1\" data-name=\"all products count badge\">\n                        8\n                    </span>\n                </button>\n                <button class=\"rounded-full border border-[#33434e] bg-[#141d25] px-4 py-2 text-[12px] font-semibold text-[#c3ccd3]\" data-kid=\"1-1-1-2-2\" data-name=\"ammunition category filter button\" type=\"button\">\n                    Munition\n                    <span class=\"ml-1 text-[#8e9eaa]\" data-kid=\"1-1-1-2-2-1\" data-name=\"ammunition count badge\">\n                        2\n                    </span>\n                </button>\n                <button class=\"rounded-full border border-[#33434e] bg-[#141d25] px-4 py-2 text-[12px] font-semibold text-[#c3ccd3]\" data-kid=\"1-1-1-2-3\" data-name=\"consumables category filter button\" type=\"button\">\n                    Verbrauchsgegenstände\n                    <span class=\"ml-1 text-[#8e9eaa]\" data-kid=\"1-1-1-2-3-1\" data-name=\"consumables count badge\">\n                        4\n                    </span>\n                </button>\n                <button class=\"rounded-full border border-[#33434e] bg-[#141d25] px-4 py-2 text-[12px] font-semibold text-[#c3ccd3]\" data-kid=\"1-1-1-2-4\" data-name=\"weapons category filter button\" type=\"button\">\n                    Waffen\n                    <span class=\"ml-1 text-[#8e9eaa]\" data-kid=\"1-1-1-2-4-1\" data-name=\"weapons count badge\">\n                        2\n                    </span>\n                </button>\n                <span class=\"ml-auto flex items-center gap-2 text-[12px] text-[#9daab4]\" data-kid=\"1-1-1-2-5\" data-name=\"sort control with category label\">\n                    <i class=\"ph ph-funnel text-[16px]\" data-kid=\"1-1-1-2-5-1\" data-name=\"filter funnel icon\" style=\"color:inherit;width:1em;height:1em\">\n                    </i>\n                    Sortierung\n                    <strong class=\"font-semibold text-[#d9e2e8]\" data-kid=\"1-1-1-2-5-2\" data-name=\"current sort value label\">\n                        Kategorien\n                    </strong>\n                    <i class=\"ph ph-caret-down text-[13px]\" data-kid=\"1-1-1-2-5-3\" data-name=\"caret down icon\" style=\"color:inherit;width:1em;height:1em\">\n                    </i>\n                </span>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1340px] px-7 pb-16 pt-7\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-5 flex items-end justify-between gap-6\" data-kid=\"1-2-1\" data-name=\"page header row with title and availability\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <div class=\"mb-2 flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[.18em] text-[#8ec6e8]\" data-kid=\"1-2-1-1-1\" data-name=\"section eyebrow with accent line\">\n                    <span class=\"h-px w-7 bg-[#8ec6e8]\" data-kid=\"1-2-1-1-1-1\" data-name=\"decorative accent line\">\n                    </span>\n                    OLYMP · Ausrüstung\n                </div>\n                <h1 class=\"font-display text-[26px] font-bold tracking-[.035em] text-white\" data-kid=\"1-2-1-1-2\" data-name=\"page main headline\">\n                    Shop-Katalog\n                </h1>\n                <p class=\"mt-1 text-[14px] text-[#9daab4]\" data-kid=\"1-2-1-1-3\" data-name=\"page subtitle text\">\n                    Verfügbare Produkte entdecken und gesammelt bestellen.\n                </p>\n            </div>\n            <div class=\"mb-1 flex items-center gap-2 rounded-full border border-[#28343e] bg-[#10161b] px-3 py-2 text-[12px] text-[#b0bcc5]\" data-kid=\"1-2-1-2\" data-name=\"availability status pill\">\n                <span class=\"size-2 rounded-full bg-[#75d59d]\" data-kid=\"1-2-1-2-1\" data-name=\"status indicator dot\">\n                </span>\n                8 Produkte verfügbar\n            </div>\n        </div>\n        <div class=\"grid grid-cols-[minmax(0,1fr)_286px] items-start gap-6\" data-kid=\"1-2-2\" data-name=\"main two-column layout\">\n            <div class=\"min-w-0\" data-kid=\"1-2-2-1\" data-name=\"left product list column\">\n                <section aria-labelledby=\"offer-title\" class=\"mb-8 overflow-hidden rounded-xl border border-[#26343e] bg-[#10161b]\" data-kid=\"1-2-2-1-1\" data-name=\"weekly deal banner section\">\n                    <div class=\"grid grid-cols-[1.05fr_.95fr] items-stretch\" data-kid=\"1-2-2-1-1-1\" data-name=\"deal banner layout\">\n                        <div class=\"relative min-h-[252px] overflow-hidden bg-[#080c10]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"deal banner image area with gradient\">\n                            <img alt=\"Wochenangebot mit Westen, Revolvern, Karabinern, Medkits, Kabelbindern und Munition\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"deal bundle illustration image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/wochenangebot.png\"/>\n                            <div class=\"absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-[#10161b]/75\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"gradient overlay for text legibility\">\n                            </div>\n                        </div>\n                        <div class=\"flex flex-col justify-center px-7 py-6\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"deal banner content panel\">\n                            <div class=\"mb-3 inline-flex w-fit items-center gap-2 rounded-full border border-[#8ec6e8]/35 bg-[#8ec6e8]/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[.17em] text-[#a8d7f0]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"weekly deal eyebrow badge\">\n                                <span class=\"size-1.5 rounded-full bg-[#8ec6e8]\" data-kid=\"1-2-2-1-1-1-2-1-1\" data-name=\"deal indicator dot\">\n                                </span>\n                                Wochenangebot\n                            </div>\n                            <h2 class=\"font-display text-[20px] font-bold leading-snug text-white\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"deal headline\" id=\"offer-title\">\n                                Aktionspaket\n                            </h2>\n                            <p class=\"mt-2 text-[13px] leading-5 text-[#bac5cd]\" data-kid=\"1-2-2-1-1-1-2-3\" data-name=\"deal bundle contents list\">\n                                10 Westen · 2 Revolver · 2 Karabiner\n                                <br data-kid=\"1-2-2-1-1-1-2-3-1\" data-name=\"line break\"/>\n                                10 Medkits · 16 Kabelbinder\n                                <br data-kid=\"1-2-2-1-1-1-2-3-2\" data-name=\"line break\"/>\n                                4 ACP-Munition · 4 5.56-Munition\n                            </p>\n                            <div class=\"mt-5 flex items-end justify-between gap-4 border-t border-white/10 pt-4\" data-kid=\"1-2-2-1-1-1-2-4\" data-name=\"deal price and CTA row\">\n                                <div data-kid=\"1-2-2-1-1-1-2-4-1\" data-name=\"deal price block\">\n                                    <div class=\"text-[10px] font-semibold uppercase tracking-[.15em] text-[#84939e]\" data-kid=\"1-2-2-1-1-1-2-4-1-1\" data-name=\"price label\">\n                                        Festpreis\n                                    </div>\n                                    <div class=\"mt-1 font-display text-[24px] font-bold text-[#a8d7f0]\" data-kid=\"1-2-2-1-1-1-2-4-1-2\" data-name=\"deal price value\">\n                                        200.000 $\n                                    </div>\n                                </div>\n                                <button class=\"inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-md bg-[#ffd814] px-5 text-[12px] font-bold text-[#17130a] shadow-[0_3px_0_#ba9906]\" data-kid=\"1-2-2-1-1-1-2-4-2\" data-name=\"add bundle to cart button\" type=\"button\">\n                                    <i class=\"ph ph-shopping-cart-simple text-[17px]\" data-kid=\"1-2-2-1-1-1-2-4-2-1\" data-name=\"shopping cart icon\" style=\"color:inherit;width:1em;height:1em\">\n                                    </i>\n                                    In den Warenkorb\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"products-title\" data-kid=\"1-2-2-1-2\" data-name=\"all products section