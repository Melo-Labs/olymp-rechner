itt.\n                    </p>\n                </section>\n                <section aria-label=\"Merkliste-Vorschau\" class=\"rounded-xl border border-[#283740] bg-[#0f151a] p-4\" data-kid=\"1-2-2-2-2\" data-name=\"wishlist preview section\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-2-2-2-1\" data-name=\"wishlist header row\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"wishlist title with icon\">\n                            <span class=\"grid size-7 place-items-center rounded-full bg-[#8ec6e8]/10 text-[17px] text-[#8ec6e8]\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"heart icon badge\">\n                                <i class=\"ph-fill ph-heart\" data-kid=\"1-2-2-2-2-1-1-1-1\" data-name=\"heart icon\" style=\"color:inherit;width:1em;height:1em\">\n                                </i>\n                            </span>\n                            <h2 class=\"font-display text-[12px] font-bold text-white\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"wishlist title\">\n                                Für später gemerkt\n                            </h2>\n                        </div>\n                        <span class=\"text-[10px] font-semibold text-[#8ec6e8]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"wishlist count\">\n                            1\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-2-2\" data-name=\"wishlist item row\">\n                        <div class=\"grid size-[54px] shrink-0 place-items-center overflow-hidden rounded-md border border-[#2b3942] bg-[#171d22]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"wishlist item image\">\n                            <img alt=\"Karabiner auf der Merkliste\" class=\"h-full w-full object-contain\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"wishlist item product image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/carabiner.png\"/>\n                        </div>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"wishlist item details\">\n                            <div class=\"text-[12px] font-bold text-[#eaf0f4]\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"wishlist item name\">\n                                Karabiner\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#a8d7f0]\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"wishlist item price\">\n                                42.500 $\n                            </div>\n                        </div>\n                        <button class=\"rounded-md border border-[#8ec6e8]/45 px-2.5 py-2 text-[10px] font-bold text-[#bde6fb]\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"wishlist action button\" type=\"button\">\n                            Merken\n                        </button>\n                    </div>\n                    <p class=\"mt-3 border-t border-white/10 pt-3 text-[10px] leading-4 text-[#81909a]\" data-kid=\"1-2-2-2-2-3\" data-name=\"wishlist privacy note\">\n                        Browserlokal gespeichert · ohne Konto. Getrennt von Wunschartikeln.\n                    </p>\n                </section>\n                <section aria-label=\"Werbung\" class=\"rounded-xl border border-[#26333d] bg-[#0d1216] p-3\" data-kid=\"1-2-2-2-3\" data-name=\"ad placement section\">\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-2-2-3-1\" data-name=\"ad header row\">\n                        <span class=\"text-[9px] font-bold uppercase tracking-[.16em] text-[#7d8b95]\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"ad label\">\n                            Werbung\n                        </span>\n                        <span class=\"text-[9px] text-[#60707a]\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"ad brand tag\">\n                            OLYMP\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-3-2\" data-name=\"ad content row\">\n                        <img alt=\"Werbefläche im OLYMP Shop\" class=\"h-[94px] w-[66px] shrink-0 rounded-md border border-[#283640] object-cover object-top\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"ad thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/werbung1.png\"/>\n                        <div data-kid=\"1-2-2-2-3-2-2\" data-name=\"ad copy block\">\n                            <h3 class=\"text-[11px] font-bold text-[#dce4e9]\" data-kid=\"1-2-2-2-3-2-2-1\" data-name=\"ad headline\">\n                                Werbefläche im OLYMP SHOP\n                            </h3>\n                            <p class=\"mt-1 text-[10px] leading-4 text-[#85939d]\" data-kid=\"1-2-2-2-3-2-2-2\" data-name=\"ad description text\">\n                                Bei Interesse gern melden.\n                            </p>\n                            <span class=\"mt-2 inline-block text-[10px] font-semibold text-[#8ec6e8]\" data-kid=\"1-2-2-2-3-2-2-3\" data-name=\"ad external link\">\n                                Mehr erfahren\n                                <span aria-hidden=\"true\" data-kid=\"1-2-2-2-3-2-2-3-1\" data-name=\"external link arrow\">\n                                    ↗\n                                </span>\n                            </span>\n                        </div>\n                    </div>\n                </section>\n                <section aria-label=\"Vorschau auf den leeren Warenkorb\" class=\"rounded-lg border border-dashed border-[#34414a] bg-[#0b1014] px-3 py-3\" data-kid=\"1-2-2-2-4\" data-name=\"empty cart state preview\">\n                    <div class=\"mb-1 text-[9px] font-bold uppercase tracking-[.13em] text-[#77858e]\" data-kid=\"1-2-2-2-4-1\" data-name=\"empty state label\">\n                        Leerzustand · 0 Artikel\n                    </div>\n                    <p class=\"text-[11px] font-semibold text-[#d5dde2]\" data-kid=\"1-2-2-2-4-2\" data-name=\"empty state description\">\n                        Dein Warenkorb ist noch leer.\n                    </p>\n                    <button class=\"mt-2 h-8 w-full cursor-not-allowed rounded-md border border-[#303a40] bg-[#182026] text-[10px] font-bold text-[#697781]\" data-kid=\"1-2-2-2-4-3\" data-name=\"disabled submit order button\" disabled=\"\" type=\"button\">\n                        Bestellung absenden\n                    </button>\n                </section>\n            </aside>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-13T13:54:39.577040+00:00",
      "modified": "2026-10-13T13:58:10.083518+00:00",
      "id": "var_6609ae8f0696",
      "contentHeight": 2112
    },
    "var_0b077a42c4ab": {
      "type": "variant",
      "label": "OLYMP Shop · Warenkorb",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css\");\n@font-face{font-family:Orbitron;font-style:normal;font-weight:500;src:url('/api/local/images/img/fonts/orbitron-latin-500-normal.woff2') format('woff2')}\n@font-face{font-family:Orbitron;font-style:normal;font-weight:700;src:url('/api/local/images/img/fonts/orbitron-latin-700-normal.woff2') format('woff2')}\n@font-face{font-family:Exo2;font-style:normal;font-weight:400;src:url('/api/local/images/img/fonts/exo-2-latin-400-normal.woff2') format('woff2')}\n@font-face{font-family:Exo2;font-style:normal;font-weight:600;src:url('/api/local/images/img/fonts/exo-2-latin-600-normal.woff2') format('woff2')}\n:root{--bg:#05070a;--surface:#0c1116;--surface-2:#111920;--surface-3:#151f27;--line:rgba(142,198,232,.18);--line-soft:rgba(236,239,244,.09);--text:#eceff2;--muted:#98a1a9;--blue:#8ec6e8;--blue-dim:#4b94b6;--gold:#ffd814;--gold-dark:#c69e00;--green:#77d99d;--display:Orbitron,Eurostile,Segoe UI,sans-serif;--body:Exo2,Segoe UI,system-ui,sans-serif}\nbody{margin:0;background:var(--bg);color:var(--text);font-family:var(--body);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}\nbutton,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed}\n.shop-shell{min-height:100vh;background:radial-gradient(ellipse 75% 52% at 48% -8%,rgba(64,105,126,.16),transparent 70%),linear-gradient(180deg,#0a0e12 0,#05070a 420px)}\n.site-header{background:rgba(10,15,20,.96);border-bottom:1px solid rgba(142,198,232,.28)}\n.header-inner,.main-inner{width:min(1376px,calc(100% - 56px));margin:0 auto}\n.topbar{display:grid;grid-template-columns:218px minmax(300px,1fr) auto;align-items:center;gap:26px;min-height:76px}\n.brand{display:flex;align-items:center;gap:12px;min-width:0}\n.brand-logo{width:46px;height:46px;object-fit:cover;border-radius:50%;border:1px solid rgba(142,198,232,.55);background:#000;box-shadow:0 0 18px rgba(142,198,232,.12)}\n.brand-wordmark{display:grid;gap:1px}\n.brand-wordmark strong{font:700 14px/1.2 var(--display);letter-spacing:.08em;color:#fff}\n.brand-wordmark span{font-size:9px;letter-spacing:.16em;color:var(--muted);text-transform:uppercase}\n.search-box{height:44px;display:flex;align-items:center;gap:12px;padding:0 14px;background:#111820;border:1px solid rgba(142,198,232,.22);border-radius:5px;color:var(--blue)}\n.search-box .icon{display:inline-grid;place-items:center;width:17px;height:17px;font-size:15px;color:var(--blue)}\n.search-box input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:var(--text);font-size:14px}\n.search-box input::placeholder{color:#919ba4}\n.search-hint{padding:3px 6px;border:1px solid rgba(255,255,255,.12);border-radius:3px;color:#87919a;font-size:10px;letter-spacing:.06em}\n.header-actions{display:flex;align-items:center;gap:9px}\n.header-action{height:42px;display:flex;align-items:center;gap:9px;padding:0 12px;border:1px solid rgba(255,255,255,.12);border-radius:4px;background:rgba(255,255,255,.025);color:var(--text);white-space:nowrap}\n.header-action .icon{display:inline-grid;place-items:center;width:18px;height:18px;font-size:16px;color:var(--blue)}\n.header-action span.copy{font-size:12px;font-weight:600}\n.header-action b{margin-left:4px;color:var(--blue);font:700 12px var(--display)}\n.header-action small{display:block;color:var(--muted);font-size:9px;letter-spacing:.1em;text-transform:uppercase}\n.header-home{height:42px;display:flex;align-items:center;gap:8px;padding:0 12px;border:1px solid rgba(255,255,255,.12);border-radius:4px;color:#d4d9de;font-size:12px;white-space:nowrap}\n.shop-nav{display:flex;align-items:center;gap:24px;height:43px;border-top:1px solid rgba(255,255,255,.06)}\n.nav-item{display:inline-flex;align-items:center;height:43px;border-bottom:2px solid transparent;color:#c0c7cd;font-size:12px;font-weight:600;white-space:nowrap}\n.nav-item.active{border-color:var(--blue);color:#fff}\n.nav-note{margin-left:auto;color:#727d86;font-size:10px;letter-spacing:.1em;text-transform:uppercase}\n.main-inner{padding:26px 0 48px}\n.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:20px}\n.eyebrow{display:block;margin-bottom:6px;color:var(--blue);font:500 9px/1.2 var(--display);letter-spacing:.18em;text-transform:uppercase}\nh1,h2,h3,p{margin-top:0}\nh1{margin:0;font:700 25px/1.2 var(--display);letter-spacing:.015em;color:#f3f5f6}\n.page-subtitle{margin:6px 0 0;color:var(--muted);font-size:13px}\n.catalog-status{display:inline-flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid rgba(119,217,157,.16);border-radius:3px;color:#b9c9be;font-size:11px;white-space:nowrap}\n.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 8px rgba(119,217,157,.38)}\n.shop-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:26px;align-items:start}\n.main-column{min-width:0;display:grid;gap:24px}\n.bundle{display:grid;grid-template-columns:1.08fr .92fr;min-height:258px;overflow:hidden;background:linear-gradient(130deg,#0c151d,#101923 65%,#0b1117);border:1px solid rgba(142,198,232,.2);border-radius:5px}\n.bundle-image{min-width:0;height:258px;overflow:hidden;background:#071019}\n.bundle-image img{display:block;width:100%;height:100%;object-fit:cover}\n.bundle-copy{display:flex;flex-direction:column;justify-content:center;padding:20px 22px 18px 25px;border-left:1px solid rgba(142,198,232,.14)}\n.bundle-label{display:inline-flex;align-items:center;gap:8px;color:#b5dff3;font:500 9px var(--display);letter-spacing:.17em;text-transform:uppercase}\n.bundle-label::before{content:\"\";width:18px;height:1px;background:var(--blue)}\n.bundle-copy h2{margin:10px 0 7px;font:700 17px/1.3 var(--display);color:#f4f7f9}\n.bundle-intro{margin:0 0 12px;color:var(--muted);font-size:12px}\n.bundle-contents{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;margin:0 0 16px;padding:0;list-style:none;color:#cad1d7;font-size:11px}\n.bundle-contents li{display:flex;align-items:center;gap:7px;white-space:nowrap}\n.bundle-contents li::before{content:\"\";width:4px;height:4px;border-radius:50%;background:var(--blue-dim);flex:0 0 auto}\n.bundle-buy{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:13px;border-top:1px solid rgba(255,255,255,.08)}\n.bundle-price{color:var(--blue);font:700 20px/1.1 var(--display);white-space:nowrap}\n.bundle-price small{display:block;margin-bottom:4px;color:#7e8c96;font:600 8px var(--body);letter-spacing:.12em;text-transform:uppercase}\n.btn-gold{min-height:38px;padding:0 14px;border:1px solid #e6bc00;border-radius:4px;background:var(--gold);color:#1a1a14;font-size:11px;font-weight:700;box-shadow:0 4px 14px rgba(255,216,20,.08);white-space:nowrap}\n.btn-gold .icon{margin-left:8px;color:#323019;font-size:12px}\n.catalog-section{display:grid;gap:13px}\n.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px}\n.section-head h2{margin:0;font:700 17px/1.25 var(--display);letter-spacing:.03em}\n.section-count{color:var(--muted);font-size:11px}\n.catalog-controls{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:10px 0;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}\n.filter-row{display:flex;align-items:center;gap:7px;flex-wrap:wrap}\n.filter-pill{min-height:30px;padding:0 11px;border:1px solid rgba(255,255,255,.1);border-radius:3px;background:rgba(255,255,255,.02);color:#aeb7bf;font-size:10px;white-space:nowrap}\n.filter-pill.active{border-color:rgba(142,198,232,.54);background:rgba(142,198,232,.1);color:#d8eff9}\n.sort-select{display:flex;align-items:center;gap:8px;min-height:30px;padding:0 9px;border:1px solid rgba(255,255,255,.1);border-radius:3px;color:#bdc5cb;font-size:10px;white-space:nowrap}\n.sort-select .icon{font-size:12px;color:var(--blue)}\n.cart-feedback{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:36px;padding:7px 10px;border-left:2px solid var(--green);background:linear-gradient(90deg,rgba(119,217,157,.08),rgba(119,217,157,.018));color:#c5e5d0;font-size:11px}\n.feedback-message{display:flex;align-items:center;gap:8px}\n.feedback-message .icon{display:inline-grid;place-items:center;width:16px;height:16px;color:var(--green);font-size:13px}\n.feedback-context{color:#91a199;font-size:10px}\n.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}\n.product-card{position:relative;display:flex;min-width:0;flex-direction:column;padding:10px;border:1px solid rgba(142,198,232,.13);border-radius:4px;background:linear-gradient(180deg,rgba(17,24,30,.95),rgba(10,14,18,.98));}\n.product-topline{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px}\n.category-tag{color:#84b6ce;font:500 8px/1.2 var(--display);letter-spacing:.11em;text-transform:uppercase}\n.favorite{display:grid;place-items:center;width:28px;height:28px;border:1px solid rgba(255,255,255,.12);border-radius:50%;background:rgba(255,255,255,.025);color:#b1bec8}\n.favorite .icon{display:inline-grid;place-items:center;width:15px;height:15px;font-size:13px;color:currentColor}\n.favorite.saved{border-color:rgba(255,118,142,.32);color:#ff7d96;background:rgba(255,118,142,.08)}\n.product-image{display:grid;place-items:center;min-height:108px;margin-bottom:9px;overflow:hidden;border:1px solid rgba(255,255,255,.045);border-radius:3px;background:radial-gradient(circle at 50% 30%,rgba(142,198,232,.09),rgba(5,8,11,.52) 68%)}\n.product-image img{display:block;width:100%;height:105px;object-fit:contain}\n.product-name{margin:0 0 2px;color:#f0f3f5;font:600 12px/1.35 var(--display);letter-spacing:.01em}\n.product-price-row{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:5px 0 9px}\n.product-price{color:#b8e4f5;font:700 14px/1.1 var(--display);white-space:nowrap}\n.stock{display:inline-flex;align-items:center;gap:5px;color:#9bd4ae;font-size:9px;white-space:nowrap}\n.stock::before{content:\"\";width:5px;height:5px;border-radius:50%;background:var(--green)}\n.product-buy{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:8px;border-top:1px solid rgba(255,255,255,.055)}\n.product-buy .btn-gold{min-height:32px;padding:0 9px;font-size:9px}\n.product-buy .btn-gold .icon{margin-left:5px}\n.product-note{color:#7e8992;font-size:9px;white-space:nowrap}\n.wish-form{padding:16px 17px 17px;border-top:1px solid rgba(142,198,232,.22);background:linear-gradient(90deg,rgba(142,198,232,.055),rgba(142,198,232,.012))}\n.wish-form-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:13px}\n.wish-form h2{margin:0;font:700 14px/1.35 var(--display)}\n.wish-form-head p{margin:4px 0 0;color:var(--muted);font-size:10px}\n.wish-form-label{color:var(--blue);font:500 8px var(--display);letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}\n.wish-fields{display:grid;grid-template-columns:1.4fr .65fr .9fr auto;gap:9px;align-items:end}\n.field{display:grid;gap:5px;min-width:0}\n.field label{color:#abb5bd;font-size:10px;font-weight:600}\n.field-value{display:flex;align-items:center;min-height:36px;padding:0 10px;border:1px solid rgba(255,255,255,.1);border-radius:3px;background:rgba(4,7,10,.6);color:#7e8992;font-size:10px}\n.add-wish{min-height:36px;padding:0 12px;border:1px solid rgba(142,198,232,.35);border-radius:3px;background:rgba(142,198,232,.1);color:#c1e3f1;font-size:10px;font-weight:600;white-space:nowrap}\n.wish-footnote{margin:9px 0 0;color:#818c94;font-size:9px}\n.side-rail{display:grid;gap:14px;min-width:0}\n.cart-panel{padding:14px 14px 13px;border:1px solid rgba(142,198,232,.24);border-radius:4px;background:linear-gradient(155deg,rgba(18,28,35,.96),rgba(9,13,17,.98))}\n.side-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px}\n.side-head h2{margin:0;font:700 13px/1.25 var(--display);letter-spacing:.015em}\n.count-pill{padding:4px 7px;border:1px solid rgba(142,198,232,.2);border-radius:3px;color:#c1e3f2;font-size:9px;white-space:nowrap}\n.cart-item{display:grid;grid-template-columns:54px minmax(0,1fr) auto;align-items:center;gap:9px;padding:8px 0 10px;border-bottom:1px solid rgba(255,255,255,.07)}\n.cart-thumb{display:grid;place-items:center;width:54px;height:54px;overflow:hidden;border:1px solid rgba(142,198,232,.12);border-radius:3px;background:#090d11}\n.cart-thumb img{width:100%;height:100%;object-fit:contain}\n.cart-item-name{margin:0 0 3px;font:600 10px/1.3 var(--display);color:#edf1f4}\n.cart-item-meta{color:var(--muted);font-size:9px}\n.cart-item-price{color:#c4e8f7;font:700 10px var(--display);white-space:nowrap}\n.cart-total{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 0 10px;color:#aeb8bf;font-size:10px}\n.cart-total strong{color:#f0f3f4;font:700 15px var(--display);white-space:nowrap}\n.cart-fields{display:grid;grid-template-columns:1fr;gap:7px}\n.cart-fields .field-value{min-height:32px;font-size:9px}\n.order-disabled{width:100%;min-height:36px;margin-top:9px;border:1px solid rgba(160,171,181,.12);border-radius:3px;background:#20272d;color:#71808a;font-size:10px;font-weight:600}\n.disabled-note{margin:6px 0 0;color:#7e8992;font-size:9px;text-align:center}\n.empty-state-preview{padding:11px 12px;border-left:2px solid rgba(144,159,171,.34);background:rgba(255,255,255,.025)}\n.preview-label{display:block;margin-bottom:5px;color:#81909a;font:500 8px var(--display);letter-spacing:.12em;text-transform:uppercase}\n.empty-state-preview p{margin:0 0 8px;color:#a0aab1;font-size:10px;line-height:1.45}\n.empty-state-preview button{width:100%;min-height:29px;border:1px solid rgba(255,255,255,.08);border-radius:3px;background:rgba(255,255,255,.025);color:#69757e;font-size:9px}\n.wishlist-panel{padding:13px 14px;border-bottom:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.018)}\n.wishlist-note{display:flex;align-items:center;gap:6px;margin:-4px 0 9px;color:#8f9aa2;font-size:9px}\n.wishlist-note .icon{width:13px;height:13px;color:#ff8299;font-size:11px}\n.saved-row{display:flex;align-items:center;gap:9px;padding:7px 0;border-top:1px solid rgba(255,255,255,.055)}\n.saved-row:first-of-type{border-top:0}\n.saved-row img{width:34px;height:34px;object-fit:contain;border-radius:3px;background:#090d11}\n.saved-row-copy{display:grid;gap:2px;min-width:0;flex:1}\n.saved-row-copy strong{color:#e6ebee;font:600 9px var(--display)}\n.saved-row-copy span{color:#a4cfe1;font-size:9px}\n.saved-row .icon{width:14px;height:14px;color:#ff8299;font-size:12px}\n.no-results-preview{padding:13px 14px;border:1px solid rgba(142,198,232,.12);border-radius:4px;background:rgba(8,14,18,.72)}\n.no-results-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px}\n.no-results-head strong{color:#cad6de;font:500 8px var(--display);letter-spacing:.11em;text-transform:uppercase}\n.no-results-head span{color:#82909a;font-size:9px}\n.query-chip{display:flex;align-items:center;gap:8px;min-height:29px;margin-bottom:8px;padding:0 9px;border:1px solid rgba(255,255,255,.08);border-radius:3px;background:#090d11;color:#bbc4ca;font-size:10px}\n.query-chip .icon{width:13px;height:13px;color:#91a2ac;font-size:11px}\n.no-results-title{margin:0 0 8px;color:#d4dce1;font-size:10px;font-weight:600;line-height:1.4}\n.wish-cta{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;min-height:31px;padding:0 9px;border:1px solid rgba(142,198,232,.24);border-radius:3px;background:rgba(142,198,232,.08);color:#bde3f4;font-size:9px;font-weight:600;text-align:left}\n.wish-cta .icon{width:13px;height:13px;color:var(--blue);font-size:11px}\n.ad-panel{display:grid;grid-template-columns:86px 1fr;align-items:center;gap:11px;padding:9px;border-top:1px solid rgba(255,255,255,.07);color:#86919a}\n.ad-panel img{width:86px;height:124px;object-fit:cover;border-radius:3px;opacity:.78}\n.ad-copy{display:grid;gap:4px;align-content:center}\n.ad-copy small{color:#77848d;font:500 8px var(--display);letter-spacing:.13em;text-transform:uppercase}\n.ad-copy strong{color:#c6d0d7;font:600 10px/1.35 var(--display)}\n.ad-copy span{color:#828e97;font-size:9px;line-height:1.4}\n.footer{display:flex;justify-content:space-between;gap:12px;margin-top:27px;padding-top:12px;border-top:1px solid rgba(255,255,255,.07);color:#626e77;font-size:9px}\n.footer strong{color:#8c99a2;font:500 9px var(--display);letter-spacing:.12em}\n@media(max-width:1160px){.header-inner,.main-inner{width:min(100% - 36px,1376px)}.shop-layout{grid-template-columns:minmax(0,1fr) 286px;gap:18px}.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.topbar{grid-template-columns:190px minmax(250px,1fr) auto;gap:14px}.header-action span.copy{font-size:11px}}\n@media(max-width:900px){.shop-layout{grid-template-columns:1fr}.side-rail{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.ad-panel{grid-column:span 2}.header-actions{gap:6px}.header-home{display:none}.topbar{grid-template-columns:180px minmax(200px,1fr) auto}}\n@media(max-width:640px){.header-inner,.main-inner{width:calc(100% - 24px)}.topbar{grid-template-columns:1fr auto;gap:10px;padding:10px 0}.brand{grid-column:1}.header-actions{grid-column:2;grid-row:1}.header-action{padding:0 8px}.header-action span.copy{display:none}.search-box{grid-column:1/-1;grid-row:2}.shop-nav{gap:16px;overflow:hidden}.nav-note{display:none}.page-heading{align-items:flex-start;flex-direction:column;margin-bottom:16px}.catalog-status{align-self:flex-start}.bundle{grid-template-columns:1fr}.bundle-image{height:auto;aspect-ratio:2/1}.bundle-copy{border-left:0;border-top:1px solid rgba(142,198,232,.14);padding:16px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.side-rail{grid-template-columns:1fr}.ad-panel{grid-column:auto}.wish-fields{grid-template-columns:1fr 1fr}.wish-fields .field:first-child{grid-column:1/-1}.wish-fields .price-field{grid-column:1}.add-wish{grid-column:2;grid-row:2}.section-head{align-items:flex-start;flex-direction:column}}\n</style>\n<div class=\"shop-shell\" data-kid=\"1\" data-name=\"shop page layout container\">\n    <header class=\"site-header\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"header-inner\" data-kid=\"1-1-1\" data-name=\"site header inner container\">\n            <div class=\"topbar\" data-kid=\"1-1-1-1\" data-name=\"header topbar (brand, search, actions)\">\n                <div class=\"brand\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo and wordmark group\">\n                    <img alt=\"\" class=\"brand-logo\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo avatar image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/Ischia-famq.png\"/>\n                    <div class=\"brand-wordmark\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand wordmark text group\">\n                        <strong data-kid=\"1-1-1-1-1-2-1\" data-name=\"brand name text\">\n                            OLYMP SHOP\n                        </strong>\n                        <span data-kid=\"1-1-1-1-1-2-2\" data-name=\"brand tagline text\">\n                            Versorgungssystem\n                        </span>\n                    </div>\n                </div>\n                <div class=\"search-box\" data-kid=\"1-1-1-1-2\" data-name=\"header product search box\">\n                    <i aria-hidden=\"true\" class=\"bi bi-search icon\" data-kid=\"1-1-1-1-2-1\" data-name=\"search magnifier icon\">\n                    </i>\n                    <input aria-label=\"Produkte suchen\" data-kid=\"1-1-1-1-2-2\" data-name=\"search input field\" placeholder=\"Produkte oder Kategorien suchen …\" type=\"search\"/>\n                    <span class=\"search-hint\" data-kid=\"1-1-1-1-2-3\" data-name=\"search hint label\">\n                        SUCHEN\n                    </span>\n                </div>\n                <div class=\"header-actions\" data-kid=\"1-1-1-1-3\" data-name=\"header action buttons group\">\n                    <div class=\"header-action\" data-kid=\"1-1-1-1-3-1\" data-name=\"wishlist header button\">\n                        <i aria-hidden=\"true\" class=\"bi bi-heart icon\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"heart icon for wishlist\">\n                        </i>\n                        <span class=\"copy\" data-kid=\"1-1-1-1-3-1-2\" data-name=\"wishlist label and count copy\">\n                            Merkliste\n                            <b data-kid=\"1-1-1-1-3-1-2-1\" data-name=\"wishlist item count badge\">\n                                2\n                            </b>\n                            <small data-kid=\"1-1-1-1-3-1-2-2\" data-name=\"wishlist storage scope note\">\n                                lokal\n                            </small>\n                        </span>\n                    </div>\n                    <div class=\"header-action\" data-kid=\"1-1-1-1-3-2\" data-name=\"shopping cart header button\">\n                        <i aria-hidden=\"true\" class=\"bi bi-bag icon\" data-kid=\"1-1-1-1-3-2-1\" data-name=\"shopping bag icon\">\n                        </i>\n                        <span class=\"copy\" data-kid=\"1-1-1-1-3-2-2\" data-name=\"shopping cart label and count copy\">\n                            Warenkorb\n                            <b data-kid=\"1-1-1-1-3-2-2-1\" data-name=\"shopping cart item count badge\">\n                                1\n                            </b>\n                        </span>\n                    </div>\n                    <div class=\"header-home\" data-kid=\"1-1-1-1-3-3\" data-name=\"home page link button\">\n                        <i aria-hidden=\"true\" class=\"bi bi-house icon\" data-kid=\"1-1-1-1-3-3-1\" data-name=\"house home icon\">\n                        </i>\n                        Startseite\n                    </div>\n                </div>\n            </div>\n            <nav aria-label=\"Shop-Bereiche\" class=\"shop-nav\" data-kid=\"1-1-1-2\" data-name=\"main shop navigation bar\">\n                <span class=\"nav-item active\" data-kid=\"1-1-1-2-1\" data-name=\"active Shop navigation item\">\n                    Shop\n                </span>\n                <span class=\"nav-item\" data-kid=\"1-1-1-2-2\" data-name=\"weekly deal navigation item\">\n                    Wochenangebot\n                </span>\n                <span class=\"nav-item\" data-kid=\"1-1-1-2-3\" data-name=\"catalog navigation item\">\n                    Katalog\n                </span>\n                <span class=\"nav-item\" data-kid=\"1-1-1-2-4\" data-name=\"wanted item navigation item\">\n                    Wunschartikel\n                </span>\n                <span class=\"nav-note\" data-kid=\"1-1-1-2-5\" data-name=\"navigation footer note text\">\n                    OLYMP · Ingame Versorgung\n                </span>\n            </nav>\n        </div>\n    </header>\n    <main class=\"main-inner\" data-kid=\"1-2\" data-name=\"main content container\">\n        <div class=\"page-heading\" data-kid=\"1-2-1\" data-name=\"page heading header row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page heading text group\">\n                <span class=\"eyebrow\" data-kid=\"1-2-1-1-1\" data-name=\"eyebrow category label\">\n                    OLYMP PROVISIONS / KATALOG\n                </span>\n                <h1 data-kid=\"1-2-1-1-2\" data-name=\"page main headline\">\n                    Shop\n                </h1>\n                <p class=\"page-subtitle\" data-kid=\"1-2-1-1-3\" data-name=\"page subtitle description\">\n                    Ausrüstung, Verbrauchsgüter und Wochenangebote.\n                </p>\n            </div>\n            <div class=\"catalog-status\" data-kid=\"1-2-1-2\" data-name=\"catalog availability status pill\">\n                <span class=\"status-dot\" data-kid=\"1-2-1-2-1\" data-name=\"green status indicator dot\">\n                </span>\n                8 Produkte verfügbar\n            </div>\n        </div>\n        <div class=\"shop-layout\" data-kid=\"1-2-2\" data-name=\"shop layout two-column grid\">\n            <div class=\"main-column\" data-kid=\"1-2-2-1\" data-name=\"main shop content column\">\n                <section aria-labelledby=\"bundle-title\" class=\"bundle\" data-kid=\"1-2-2-1-1\" data-name=\"weekly bundle offer section\">\n                    <div class=\"bundle-image\" data-kid=\"1-2-2-1-1-1\" data-name=\"bundle product image frame\">\n                        <img alt=\"OLYMP Wochenangebot mit Ausrüstung, Munition und Verbrauchsgegenständen\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"bundle promotional image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/img/wochenangebot.png\"/>\n                    </div>\n                    <div class=\"bundle-copy\" data-kid=\"1-2-2-1-1-2\" data-name=\"bundle offer copy area\">\n                        <span class=\"bundle-label\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"bundle section label\">\n                            Aktuelles Wochenangebot\n                        </span>\n                        <h2 data-kid=\"1-2-2-1-1-2-2\" data-name=\"bundle offer title\" id=\"bundle-title\">\n                            Versorgungspaket\n                        </h2>\n                        <p class=\"bundle-intro\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"bundle offer short description\">\n                            Einmal alles Wichtige — direkt im Paket.\n                        </p>\n                        <ul class=\"bundle-contents\" data-kid=\"1-2-2-1-1-2-4\" data-name=\"bundle contents list\">\n                            <li data-kid=\"1-2-2-1-1-2-4-1\" data-name=\"bundle content item row\">\n                                10× Weste · 2× Revolver\n                            </li>\n                            <li data-kid=\"1-2-2-1-1-2-4-2\" data-name=\"bundle content item row\">\n                                2× Karabiner · 10× Medkit\n                            </li>\n                            <li data-kid=\"1-2-2-1-1-2-4-3\" data-name=\"bundle content item row\">\n                                16× Kabelbinder\n                            </li>\n                            <li data-kid=\"1-2-2-1-1-2-4-4\" data-name=\"bundle content item row\">\n                                4× ACP- & 4× 5.56-Muni\n                            </li>\n                        </ul>\n                        <div class=\"bundle-buy\" data-kid=\"1-2-2-1-1-2-5\" data-name=\"bundle purchase action row\">\n                            <strong class=\"bundle-price\" data-kid=\"1-2-2-1-1-2-5-1\" data-name=\"bundle fixed price display\">\n                                <small data-kid=\"1-2-2-1-1-2-5-1-1\" data-name=\"price label text\">\n                                    Festpreis\n                                </small>\n                                200.000 $\n                            </strong>\n                            <button class=\"btn-gold\" data-kid=\"1-2-2-1-1-2-5-2\" data-name=\"bundle add-to-cart button\" type=\"button\">\n                                Paket in den Warenkorb\n                                <i aria-hidden=\"true\" class=\"bi bi-arrow-right icon\" data-kid=\"1-2-2-1-1-2-5-2-1\" data-name=\"arrow-right button icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"catalog-title\" class=\"catalog-section\" data-kid=\"1-2-2-1-2\" data-name=\"product catalog section\">\n                    <div class=\"section-head\" data-kid=\"1-2-2-1-2-1\" data-name=\"catalog section header row\">\n                        <div data-kid=\"1-2-2-1-2-1-1\" data-name=\"catalog section title group\">\n                            <span class=\"eyebrow\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"catalog section eyebrow label\">\n                                AUSRÜSTUNG & VERSORGUNG\n                            </span>\n                            <h2 data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"catalog section headline\" id=\"catalog-title\">\n                                Alle Produkte\n                            </h2>\n                        </div>\n                        <span class=\"section-count\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"catalog item count text\">\n                            8 Artikel · alphabetisch\n                        </span>\n                    </div>\n                    <div class=\"catalog-controls\" data-kid=\"1-2-2-1-2-2\" data-name=\"catalog filter and sort controls\">\n                        <div aria-label=\"Kategorien\" class=\"filter-row\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"category filter pill row\">\n                            <button class=\"filter-pill active\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"active All items filter pill\" type=\"button\">\n                                Alle Artikel\n                                <span data-kid=\"1-2-2-1-2-2-1-1-1\" data-name=\"All items filter count\">\n                                    8\n                                </span>\n                            </button>\n                            <button class=\"filter-pill\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"Ammunition filter pill\" type=\"button\">\n                                Munition\n                                <span data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"Ammunition filter count\">\n                                    2\n                                </span>\n                            </button>\n                            <button class=\"filter-pill\" data-kid=\"1-2-2-1-2-2-1-3\" data-name=\"Consumables filter pill\" type=\"button\">\n                                Verbrauchsgegenstände\n               